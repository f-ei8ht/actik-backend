# API
FRONTEND_ORIGIN=http://localhost:3000

# HydraDB
# Required for prod compose; must be at least 32 characters.
# Leave unset for dev to use the compose default dev token.
HYDRADB_AUTH_TOKEN=change-me-to-a-32-plus-character-token
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0
# Leave empty to use the compose default http://hydradb:8443 (service name).
HYDRADB_HTTP_URL=

# Ingestion (all optional; defaults are fine)
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_JSON_URL=https://pypi.org/pypi
OSV_API_URL=https://api.osv.dev
INGESTION_MAX_PACKAGES=50
INGESTION_MAX_DEPTH=2
INGESTION_MAX_ADVISORIES=500
INGESTION_CONCURRENCY=8

# Synthetic organization (repositories + lockfiles) ingested after the
# package graph. Relative to the backend working directory.
DEMO_ORG_PATH=demo-org
